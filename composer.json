{
    "name": "tomwilford/lorem-docsum",
    "description": "A lorem ipsum generator for documents",
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Wilford",
            "homepage": "https://jollyblueman.com"
        }
    ],
    "support": {
        "email": "hello@jollyblueman.com"
    },
    "autoload": {
        "psr-4": {
            "TomWilford\\LoremDocsum\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0
    },
    "require": {
        "php": "^8.3",
        "fakerphp/faker": "^1.24",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --format=txt --verbose --config=.cs.php --ansi",
        "cs:fix": "php-cs-fixer fix --config=.cs.php --ansi --verbose",
        "sniffer:check": "phpcs --standard=phpcs.xml",
        "sniffer:fix": "phpcbf --standard=phpcs.xml",
        "stan": "phpstan analyse -c phpstan.neon --no-progress --ansi"
    }
}
